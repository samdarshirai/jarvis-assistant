# Google email of user #1 (the owner). Required on first start: it seeds the owner, adopts pre-multi-user rows and
# copies the operator keys below into the owner's account once.
JARVIS_OWNER_EMAIL=
# Operator keys: read ONCE to seed the owner's account, then unused. Never a fallback for friends, who bring their own.
JARVIS_OPENROUTER_API_KEY=
# seeded into the owner once; also the default model ids offered to new users. Comma-separated OpenRouter model ids, first is primary, rest are fallbacks; choose after scenario evaluation
JARVIS_MODELS_FAST=
JARVIS_MODELS_STRONG=
JARVIS_DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
JARVIS_TELEGRAM_BOT_TOKEN=
# Telegram serves the owner only; friends get push alerts
JARVIS_TELEGRAM_OWNER_CHAT_ID=
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_FERNET_KEY=
JARVIS_GOOGLE_CLIENT_SECRETS=client_secret.json
# Sign in with Google: Web OAuth client JSON + this backend's public https URL.
# Add <JARVIS_PUBLIC_BASE_URL>/auth/callback as an authorized redirect URI on that client (docs/DEPLOY-RAILWAY.md).
JARVIS_GOOGLE_WEB_CLIENT_SECRETS=
JARVIS_PUBLIC_BASE_URL=
JARVIS_TIMEZONE=Europe/Berlin
# shared by all users (they only add their own LLM key); a key a user saves in the app overrides it
JARVIS_DEEPGRAM_API_KEY=
# Firebase service-account JSON for push (optional until you want tap-to-play push)
JARVIS_FCM_CREDENTIALS_PATH=
# Tavily API key for web research (optional). Search queries are sent to Tavily; page fetches go straight to the site.
# shared by all users; leave empty to fall back to keyless DuckDuckGo search
JARVIS_TAVILY_API_KEY=

# Proactive features (all optional, defaults shown)
JARVIS_BRIEF_ENABLED=true
JARVIS_BRIEF_TIME=07:30
JARVIS_LEAVE_LEAD_MINUTES=30
JARVIS_MAIL_POLL_MINUTES=5
JARVIS_AUTO_EVENT_CAP=5
